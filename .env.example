# ==========================================
# Google Cloud Service Account Credentials
# ==========================================
# Service Account Email from Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# Service Account Private Key (keep \n characters or wrap in double quotes)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Target Google Sheet Spreadsheet ID (from URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit)
GOOGLE_SHEET_ID=your_google_sheet_id_here

# ==========================================
# Google Drive Folder IDs (from URL: drive.google.com/drive/folders/<FOLDER_ID>)
# ==========================================
# Folder: Nubtang/nubtang_slips/kplus
GOOGLE_DRIVE_KPLUS_FOLDER_ID=your_kplus_folder_id_here

# Folder: Nubtang/nubtang_slips/make
GOOGLE_DRIVE_MAKE_FOLDER_ID=your_make_folder_id_here

# Folder: Nubtang/nubtang_slips/paotang
GOOGLE_DRIVE_PAOTANG_FOLDER_ID=your_paotang_folder_id_here

# Folder: Nubtang/nubtang_statements (e-Statement PDFs)
GOOGLE_DRIVE_STATEMENT_FOLDER_ID=your_statement_folder_id_here
STATEMENT_PASSWORD=your_statement_pdf_password_here

# ==========================================
# Gemini AI for Slip OCR (Free API Key from https://aistudio.google.com)
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# Bank Account Numbers (สำหรับตรวจจับบัญชีและการโอนย้าย)
# ==========================================
KPLUS_ACCOUNT_NO=0568966651
MAKE_ACCOUNT_NO=1183962996
WEBHOOK_SECRET=nubtang_webhook_secret_token_123

# ==========================================
# Self-Transfer Detection (ตรวจจับการโยกเงินระหว่างบัญชีตนเอง)
# ==========================================
# Put your full name, nicknames, or account names here (comma-separated)
# If receiver matches these names, transaction will be marked as 'TRANSFER'
OWN_ACCOUNT_NAMES="นาย สมชาย ใจดี,Somchai,MAKE-12345"

# ==========================================
# LINE Bot (Messaging API)
# ==========================================
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# ==========================================
# Background Auto-Sync Scheduler
# ==========================================
# Enable automatic background syncing without opening the browser (true/false)
ENABLE_BACKGROUND_SYNC=true

# Auto-sync interval in minutes (default: 60 = every 1 hour)
AUTO_SYNC_INTERVAL_MINUTES=60

# Optional Secret Token for triggering /api/cron/sync from external cron/webhook
CRON_SECRET=nubtang_cron_secret_token_123

# ==========================================
# Authentication & Security
# ==========================================
# Secret key for JWT session cookies (at least 32 characters)
SESSION_SECRET=nubtang_secret_session_key_replace_with_random_string_32chars

# Default admin credentials for first-time login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=nubtang1234
